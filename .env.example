# Razorpay — payment links & collections
RZP_KEY_ID=
RZP_KEY_SECRET=

# Twilio — WhatsApp reminders
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
# Your own joined sandbox number, e.g. whatsapp:+91XXXXXXXXXX (dev: all clients use this)
MY_WHATSAPP=

# Gemini — primary LLM for reply classification
GEMINI_API_KEY=

# OpenAI — fallback LLM / message drafting
OPENAI_API_KEY=

# Vapi — voice call (rung 4). Public key is browser-safe; private key server-only.
VAPI_PUBLIC_KEY=your_vapi_public_key_here
VAPI_PRIVATE_KEY=your_vapi_private_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_API_KEY=your_vapi_api_key_here

# Resend — post-call email summaries. FROM_EMAIL onboarding@resend.dev only
# delivers to the account owner, so DEMO_EMAIL overrides every recipient.
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=onboarding@resend.dev
DEMO_EMAIL=your_email@example.com
